     int leituraSensores[numSensores];
 for (int n = 0; n < numSensores; n++){
   leituraSensores[n] = analogRead(pinoSensores[n]);
 }

 // Terminou a leitura dos sensores, usar o monitor serial pra ver as respostas??
 int somaEsquerda = 0;
 int somaDireita = 0;
 // Os primeiros quatro sensores vão identificar o lado ESQUERDO
 for (int i = 0; i < numSensores; i++){ // Começa um for pra percorrer todos os sensores
   if (i < numSensores / 2){ // Pra conferir se ta pegando informação dos quatro primeiro sensores
     somaDireita += leituraSensores[i]; // += É de atribuição, tá armazenando as leituras dos 4 primeiro sensores
   } else {
     somaEsquerda += leituraSensores[i];
   }
 }
 // Terminou de armazenar as somas!!!!
 int erro = somaDireita - somaEsquerda; // Calcula o erro, se for maior vai pra direita
 // ERRO POSITIVO = LADO DIREITO DETECTA MAIS A LINHA, CORRIGIR INDO PRA DIREITA
 // ERRO NEGATIVO = LADO ESQUERDO DETECTA MAIS A LINHA, CORRIGIR INDO PRA ESQUEDA
 if (erro > 0){ // Faz curva pra direita desligando o motor esquerdo

  digitalWrite(PINO_IN1, LOW); //MOTOR ESQUERDO
  digitalWrite(PINO_IN2, LOW);
  digitalWrite(PINO_IN3, HIGH); // MOTOR DIREITO
  digitalWrite(PINO_IN4, LOW);

   
 
 } else if ( erro < 0){ // Faz curva pra esquerda desligando o motor direito
 
  digitalWrite(PINO_IN1, HIGH); //MOTOR ESQUERDO
  digitalWrite(PINO_IN2, LOW);
  digitalWrite(PINO_IN3, LOW); // MOTOR DIREITO
  digitalWrite(PINO_IN4, LOW);
   
   
 } else { // Os dois identificam a linha então os dois devem seguir em frente

  digitalWrite(PINO_IN1, HIGH); 
  digitalWrite(PINO_IN2, LOW);
  digitalWrite(PINO_IN3, HIGH);
  digitalWrite(PINO_IN4, LOW);
 }
 
  }

