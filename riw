#define sensorD A6
#define sensorE A7
const int PINO_ENA = 5; 
const int PINO_ENB = 11;

//declaracao dos pinos utilizados para controlar o sentido do motor
const int PINO_IN1 = 6; //primeiro motor
const int PINO_IN2 = 7;
const int PINO_IN3 = 9; //segundo motor
const int PINO_IN4 = 10;

#define standby 8

const int numSensores = 4;
int pinoSensores[numSensores]={A1,A2,A3,A4};
#define portaAtivacao 13
int contadorD = 0;
int contadorE = 0;
unsigned long tempoAnterior = 0;
const unsigned long intervaloLeitura = 2500;

void setup() {
  //configuração dos pinos como saida
  pinMode(PINO_ENA, OUTPUT); 
  pinMode(PINO_ENB, OUTPUT);
  pinMode(PINO_IN1, OUTPUT);
  pinMode(PINO_IN2, OUTPUT);
  pinMode(PINO_IN3, OUTPUT);
  pinMode(PINO_IN4, OUTPUT);

  pinMode(sensorD, INPUT);
  pinMode(sensorE, INPUT);

  //inicia o codigo com os motores parados
  digitalWrite(PINO_IN1, LOW); 
  digitalWrite(PINO_IN2, LOW);
  digitalWrite(PINO_IN3, LOW);
  digitalWrite(PINO_IN4, LOW);
  digitalWrite(PINO_ENA, LOW);
  digitalWrite(PINO_ENB, LOW);
  digitalWrite(standby, HIGH);

 Serial.begin(9600); // Pra ter leitura no motor serial
// termina a parte de definir os sensores laterais para receber informação
 pinMode(portaAtivacao, INPUT); // ou output?
 digitalWrite(portaAtivacao, HIGH); // termina configurações do motor serial
 for(int i = 0; i<numSensores; i++){
   pinMode(pinoSensores[i], INPUT); //Usa um for pra fazer o define dos sensores de forma mais compacta
}
}

